# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role key — SECRET, server-side only (webhook fulfillment bypasses RLS).
# Supabase Dashboard → Settings → API → "service_role" (use the "secret" key).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe Dashboard → Developers → Webhooks → your endpoint's "Signing secret",
# or the value printed by `stripe listen` during local development.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: override the Managed Payments preview header (default 2026-02-25.preview)
# if your Stripe account is on a newer dated API (e.g. 2026-06-24.dahlia).
# STRIPE_MANAGED_PAYMENTS_API_VERSION=2026-02-25.preview

# ─── Google Classroom (see GOOGLE-CLASSROOM-SETUP.md) ────────────────────────
# PATH A (recommended): Google Workspace service account + domain-wide delegation.
# Entire service account JSON on ONE line:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...",...}
# GOOGLE_CLASSROOM_TEACHER_EMAIL=teacher@your-domain.com
#
# PATH B (quick start): personal Gmail teacher account + OAuth refresh token.
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...
#
# Optional pre-migration mapping of courseid → Google Classroom ID (JSON):
# GOOGLE_CLASSROOM_COURSE_MAP={"1":"731234567890","2":"731234567891"}
